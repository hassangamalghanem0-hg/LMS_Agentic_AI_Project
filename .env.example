# ---------------------------------------------------------------------------
# Copy to .env (same folder as manage.py) and fill in. Nothing here is secret
# by default -- the project runs with all of it missing, just without AI.
# ---------------------------------------------------------------------------

# Google Gemini key -- free from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Primary model. If a name 404s, it is dropped automatically and the chain
# below is used instead, so a retired model name can't take the app down.
GEMINI_MODEL=gemini-3.8-flash

# Ordered fallbacks, tried when the primary is rate-limited (429) or retired.
# Each model name has its own free-tier quota bucket, which is the whole point:
# when the flagship model is exhausted, a lite model usually still answers.
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-2.5-flash,gemini-2.5-flash-lite

# Set to 1 to skip the API entirely and run on the offline rule-based engine.
# Useful for a demo/defence where predictability beats AI-quality answers.
AI_OFFLINE_MODE=0

# Database. Leave as postgresql for the real setup; set to sqlite to run the
# whole project on a local db.sqlite3 file (handy if Postgres isn't running).
DB_ENGINE=postgresql
DB_NAME=lms_db
DB_USER=postgres
DB_PASSWORD=12345
DB_HOST=localhost
DB_PORT=5432

DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
